      "parameters": {
        "jsCode": "const history = $input.all().map(item => ({\n  role: item.json.role,\n  content: String(item.json.content)\n})).filter(m => m.role && m.content);\n\nconst recentHistory = history.slice(-10);\nconst newUserMessage = $('Telegram Trigger').item.json.message.text;\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\n\nconst messages = [\n  ...recentHistory,\n  {\n    role: \"user\",\n    content: newUserMessage\n  }\n];\n\nreturn [{\n  json: {\n    messages: messages,\n    chatId: chatId,\n    newUserMessage: newUserMessage\n  }\n}];"
