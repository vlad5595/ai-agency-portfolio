        "jsCode": "const chatId = $('Prepare messages').item.json.chatId;\nconst userMessage = $('Prepare messages').item.json.newUserMessage;\nconst assistantMessage = $input.first().json.choices[0].message.content;\nconst timestamp = new Date().toISOString();\n\nreturn [\n  {\n    json: {\n      chat_id: chatId,\n      role: \"user\",\n      content: userMessage,\n      timestamp: timestamp\n    }\n  },\n  {\n    json: {\n      chat_id: chatId,\n      role: \"assistant\",\n      content: assistantMessage,\n      timestamp: timestamp\n    }\n  }\n];"
