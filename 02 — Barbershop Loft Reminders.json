      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const desc = item.json.description || '';\n  \n  // Уже отправляли напоминание — пропускаем\n  if (desc.includes('reminded:true')) continue;\n  \n  // Парсим chat_id\n  const match = desc.match(/chat_id:\\s*(\\d+)/);\n  if (!match) continue;\n  \n  results.push({\n    json: {\n      eventId: item.json.id,\n      calendarId: item.json.calendarId || 'primary',\n      chatId: match[1],\n      summary: item.json.summary || '',\n      start: item.json.start?.dateTime || '',\n      description: desc\n    }\n  });\n}\n\nreturn results;"
      },
