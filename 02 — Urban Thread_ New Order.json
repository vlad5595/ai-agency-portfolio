    {
      "parameters": {
        "jsCode": "const orderItems = $('Generate Order').first().json.items_raw;\nconst inventoryRows = $input.all().map(item => item.json);\n\n// Какие SKU и сколько списать\nconst toDeduct = {};\nfor (const item of orderItems) {\n  const fullSku = `${item.sku}-${item.size}`;\n  toDeduct[fullSku] = (toDeduct[fullSku] || 0) + item.qty;\n}\n\n// Находим совпавшие строки, уменьшаем stock\nconst updatedRows = [];\nfor (const row of inventoryRows) {\n  if (toDeduct[row.sku]) {\n    updatedRows.push({\n      json: {\n        ...row,\n        stock: Math.max(0, Number(row.stock) - toDeduct[row.sku])\n      }\n    });\n  }\n}\n\nif (updatedRows.length === 0) {\n  return [{ json: { _skip: true } }];\n}\n\nreturn updatedRows;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "id": "127a499d-2279-4956-809a-aa191db9bf90",
      "name": "Update Stock"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst input = {\n  ...raw,\n  items: typeof raw.items === 'string' ? JSON.parse(raw.items) : raw.items\n};\n\n// Каталог цен (6 SKU, зашиты в код — нет смысла тянуть из таблицы)\nconst catalog = {\n  \"UT-001\": { name: \"Футболка Oversize Basic\", price: 2490 },\n  \"UT-002\": { name: \"Худи Urban Classic\", price: 4990 },\n  \"UT-003\": { name: \"Джоггеры Street Fit\", price: 3790 },\n  \"UT-004\": { name: \"Лонгслив Minimal\", price: 2990 },\n  \"UT-005\": { name: \"Шорты Cargo Relaxed\", price: 2990 },\n  \"UT-006\": { name: \"Бомбер City Layer\", price: 6990 }\n};\n\n// Генерация order_id: UT-YYYYMMDD-NNN\nconst now = new Date();\nconst yyyy = now.getFullYear();\nconst mm = String(now.getMonth() + 1).padStart(2, '0');\nconst dd = String(now.getDate()).padStart(2, '0');\nconst nnn = String(Math.floor(Math.random() * 900) + 100);\nconst order_id = `UT-${yyyy}${mm}${dd}-${nnn}`;\n\n// Подсчёт total и формирование строки items\nlet total = 0;\nconst itemParts = [];\n\nfor (const item of input.items) {\n  const product = catalog[item.sku];\n  if (!product) continue; // неизвестный SKU — пропускаем\n  const subtotal = product.price * item.qty;\n  total += subtotal;\n  itemParts.push(`${item.sku} (${item.size}) × ${item.qty}`);\n}\n\nconst today = `${yyyy}-${mm}-${dd}`;\n\nreturn [{\n  json: {\n    order_id,\n    chat_id: input.chat_id,\n    client_name: input.client_name,\n    items_text: itemParts.join(', '),\n    items_raw: input.items,       // сохраняем массив для обновления Inventory\n    total,\n    status: 'processing',\n    tracking: '',\n    created_at: today,\n    updated_at: today,\n    address: input.address,\n    payment_method: input.payment_method,\n    notes: ''\n  }\n}];"
      },
