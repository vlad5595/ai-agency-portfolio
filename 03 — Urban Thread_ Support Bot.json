    {
      "parameters": {
        "jsCode": "// Данные из Telegram Trigger\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\nconst userName = $('Telegram Trigger').first().json.message.from.first_name || 'клиент';\nconst userMessage = $('Telegram Trigger').first().json.message.text || '';\n\n// Заказы клиента из Get Orders\nconst ordersRaw = $('Get Orders').all().map(item => item.json);\nlet ordersData = 'Заказов не найдено.';\n\nif (ordersRaw.length > 0 && !ordersRaw[0]._skip) {\n  ordersData = ordersRaw.map(o =>\n    `Заказ ${o.order_id} | Статус: ${o.status} | Состав: ${o.items} | Сумма: ${o.total}₽ | Трек: ${o.tracking || 'нет'} | Создан: ${o.created_at} | Адрес: ${o.address}`\n  ).join('\\n');\n}\n\n// История диалога из Get History\nconst historyRaw = $('Get History').all().map(item => item.json).filter(h => h.role && h.content);\nconst messages = [];\n\n// System prompt\nconst systemPrompt = `Ты — бот поддержки интернет-магазина одежды URBAN THREAD.\n\nПРАВИЛА:\n- Обращайся на «ты», дружелюбно, но без панибратства\n- Отвечай кратко: 1–3 предложения\n- Максимум 1 эмодзи на сообщение (📦, ✅, 👕)\n- Данные заказа — только из раздела ЗАКАЗЫ КЛИЕНТА ниже. Не выдумывай\n- Если вопрос вне твоих сценариев — «Передам вопрос менеджеру, он ответит в рабочее время (пн–пт 10:00–19:00)»\n- Не принимай оплату, не меняй адрес — только фиксируй запрос\n- Up-sell: максимум 1 предложение за диалог, только если уместно\n- Если клиент злится — извинись коротко, предложи связь с менеджером\n\nСТАТУСЫ:\n- processing: заказ собирается на складе, отправка 1–2 рабочих дня\n- shipped: отправлен, можно отследить по трек-номеру на сайте СДЭК\n- delivered: доставлен\n- return_requested: заявка на возврат принята, менеджер свяжется в течение 24ч\n- return_done: возврат оформлен, деньги вернутся на карту за 3–5 рабочих дней\n\nВОЗВРАТ:\n- Только если статус = delivered\n- В течение 14 дней с получения\n- Товар не ношен, бирки на месте\n- Брак — возврат за счёт магазина\n\nFAQ:\n- Оплата: карта (Visa/MC/МИР), СБП, наличные при получении\n- Доставка: СДЭК, 2–5 дней Москва, 3–7 дней РФ. Бесплатно от 5000₽, иначе 350₽\n- Размеры: S 44–46, M 48–50, L 52–54, XL 56–58\n- Поддержка: бот 24/7, менеджер пн–пт 10:00–19:00 МСК\n- Каталог: urbanthread.ru\n\nЗАКАЗЫ КЛИЕНТА:\n${ordersData}\n\nЕсли заказов нет — скажи, что не нашёл заказов по этому аккаунту, и предложи назвать номер заказа или связаться с менеджером.`;\n\nmessages.push({ role: 'system', content: systemPrompt });\n\n// Добавляем историю (последние 20 сообщений)\nconst recentHistory = historyRaw.slice(-20);\nfor (const h of recentHistory) {\n  messages.push({ role: h.role, content: h.content });\n}\n\n// Добавляем новое сообщение пользователя\nmessages.push({ role: 'user', content: userMessage });\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    user_name: userName,\n    user_message: userMessage,\n    messages,\n    request_body: JSON.stringify({\n      model: \"deepseek-chat\",\n      messages: messages,\n      response_format: { type: \"text\" }\n    })\n  }\n}];"
      },
