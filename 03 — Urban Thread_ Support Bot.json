    {
      "parameters": {
        "jsCode": "const chatId = $('Build Prompt').first().json.chat_id;\nconst userMessage = $('Build Prompt').first().json.user_message;\nconst assistantMessage = $('DeepSeek').first().json.choices[0].message.content;\nconst now = new Date().toISOString();\n\nreturn [\n  {\n    json: {\n      chat_id: chatId,\n      role: 'user',\n      content: userMessage,\n      timestamp: now\n    }\n  },\n  {\n    json: {\n      chat_id: chatId,\n      role: 'assistant',\n      content: assistantMessage,\n      timestamp: now\n    }\n  }\n];"
      },
