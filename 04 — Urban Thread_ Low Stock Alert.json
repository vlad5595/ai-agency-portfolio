    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nconst lowStock = rows.filter(r => Number(r.stock) <= Number(r.low_threshold));\n\nif (lowStock.length === 0) {\n  return [{ json: { _skip: true, message: 'Все остатки в норме' } }];\n}\n\nconst lines = lowStock.map(r =>\n  `⚠️ ${r.name} (${r.sku}) — осталось ${r.stock} шт. (порог: ${r.low_threshold})`\n);\n\nreturn [{\n  json: {\n    _skip: false,\n    count: lowStock.length,\n    alert_text: lines.join('\\n')\n  }\n}];"
      },
