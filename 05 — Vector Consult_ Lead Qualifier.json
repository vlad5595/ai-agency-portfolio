    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst prevData = $('Build Prompt').first().json;\n\n// Парсим ответ DeepSeek\nconst content = input.choices[0].message.content;\nconst result = JSON.parse(content);\n\n// Генерируем lead_id: VK-YYYYMMDD-NNN\nconst now = new Date();\nconst dateStr = now.toISOString().slice(0, 10).replace(/-/g, '');\nconst rand = String(Math.floor(Math.random() * 900) + 100);\nconst leadId = `VK-${dateStr}-${rand}`;\n\nconst processedAt = now.toISOString().slice(0, 19);\n\n// Emoji для Telegram\nconst emoji = { hot: '🔥', warm: '🟡', cold: '🔵' };\nconst categoryEmoji = emoji[result.category] || '❓';\n\n// Telegram-сообщение (HTML)\nconst telegramMessage = `${categoryEmoji} <b>Новый лид: ${result.category.toUpperCase()}</b> (${result.score}/10)\\n\\nИмя: ${prevData.lead_name}\\nКомпания: ${prevData.lead_company}\\nДолжность: ${prevData.lead_position}\\nEmail: ${prevData.lead_email}\\n\\n<b>Обоснование:</b> ${result.reasoning}\\n\\n<b>Рекомендация:</b> ${result.recommended_action}`;\n\nreturn [{\n  json: {\n    // Для Sheets (порядок = порядок столбцов A–N)\n    lead_id: leadId,\n    name: prevData.lead_name,\n    company: prevData.lead_company,\n    position: prevData.lead_position,\n    employees: prevData.lead_employees,\n    email: prevData.lead_email,\n    phone: prevData.lead_phone ? \"'\" + prevData.lead_phone : '',\n    message: prevData.lead_message,\n    category: result.category,\n    score: result.score,\n    reasoning: result.reasoning,\n    recommended_action: result.recommended_action,\n    response_priority: result.response_priority,\n    processed_at: processedAt,\n    // Для Telegram и IF\n    telegram_message: telegramMessage\n  }\n}];"
      },
