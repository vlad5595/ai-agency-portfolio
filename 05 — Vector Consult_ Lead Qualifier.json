        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.request_body }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        416,
        0
      ],
      "id": "ebd417b6-beae-45a4-bf31-855e39b96a9f",
      "name": "DeepSeek",
      "credentials": {
        "httpHeaderAuth": {
          "id": "mP5T7DHPI4HKzCJm",
          "name": "Header Auth account"
        }
      }
