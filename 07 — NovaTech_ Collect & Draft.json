    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\n\nconst systemPrompt = `Ты — контент-менеджер digital-студии NovaTech Solutions.\nСтудия разрабатывает сайты и мобильные приложения для бизнеса.\nАудитория канала: владельцы малого и среднего бизнеса, маркетологи, предприниматели.\n\nЗадача: написать пост для Telegram-канала на основе новости ниже.\n\nПравила:\n1. Заголовок: 5–10 слов, эмодзи 🔷 в начале\n2. Суть новости: 2–3 предложения, простым языком без жаргона\n3. Экспертный комментарий от лица NovaTech: 2–3 предложения — что это значит для бизнеса клиентов студии, практический вывод\n4. 2–3 хештега в конце\n5. Общая длина: 600–900 символов\n6. Тон: профессиональный, но дружелюбный. Без канцеляризмов, без восклицательных знаков подряд, без «друзья!»\n7. Не начинай с «В мире технологий», «Сегодня стало известно» и подобных клише\n8. Пиши по-русски\n\nОтветь строго в JSON:\n{\n  \"title\": \"заголовок поста\",\n  \"body\": \"полный текст поста готовый к публикации\",\n  \"tags\": [\"тег1\", \"тег2\"],\n  \"source_comment\": \"одно предложение — почему эта новость важна для аудитории\"\n}`;\n\nconst userMessage = `Новость:\\nЗаголовок: ${item.source_title}\\n\\nТекст:\\n${item.source_content}\\n\\nИсточник: ${item.source_url}`;\n\nreturn {\n  json: {\n    ...item,\n    request_body: JSON.stringify({\n      model: \"deepseek-chat\",\n      messages: [\n        { role: \"system\", content: systemPrompt },\n        { role: \"user\", content: userMessage }\n      ],\n      response_format: { type: \"json_object\" },\n      temperature: 0.7\n    })\n  }\n};"
      },
