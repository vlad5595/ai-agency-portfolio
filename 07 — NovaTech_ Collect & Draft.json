    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst source = $('Build Prompt').item.json;\n\n// Парсим ответ DeepSeek\nconst content = item.choices[0].message.content;\nconst parsed = JSON.parse(content);\n\n// Генерируем draft_id\nconst now = new Date();\nconst dateStr = now.toISOString().slice(0, 10).replace(/-/g, '');\nconst rand = String(Math.floor(Math.random() * 900) + 100);\nconst draftId = `NT-${dateStr}-${rand}`;\n\nconst createdAt = now.toISOString().slice(0, 19).replace('T', ' ');\n\n// Telegram preview для CEO\nconst preview = `📝 <b>Новый черновик</b>\\n\\n`\n  + `<b>${parsed.title}</b>\\n\\n`\n  + `${parsed.body}\\n\\n`\n  + `💡 <i>${parsed.source_comment}</i>\\n\\n`\n  + `🆔 ${draftId}`;\n\nreturn {\n  json: {\n    draft_id: draftId,\n    source_url: source.source_url,\n    source_title: source.source_title,\n    post_title: parsed.title,\n    post_body: parsed.body,\n    tags: parsed.tags.join(', '),\n    source_comment: parsed.source_comment,\n    status: 'draft',\n    created_at: createdAt,\n    published_at: '',\n    telegram_preview: preview\n  }\n};"
      },
