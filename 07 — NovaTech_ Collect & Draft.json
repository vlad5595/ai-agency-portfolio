    {
      "parameters": {
        "jsCode": "// Входы: Merge — RSS-статьи, Get Rows — existing drafts\nconst articles = $('Merge').all();\n\n// Получаем существующие source_title из Sheets\nlet existingTitles = new Set();\ntry {\n  const existingItems = $('Get Rows').all();\n  existingTitles = new Set(\n    existingItems\n      .map(row => (row.json.source_title || '').toLowerCase().trim())\n      .filter(t => t.length > 0)\n  );\n} catch (e) {\n  // Таблица пустая или нода не выполнилась — дубликатов нет\n  existingTitles = new Set();\n}\n\n// Фильтр 1: только за последние 24 часа\nconst now = new Date();\nconst cutoff = new Date(now.getTime() - 24 * 60 * 60 * 1000);\n\nconst recent = articles.filter(item => {\n  const pub = new Date(item.json.pubDate || item.json.isoDate || item.json.date || 0);\n  return pub >= cutoff;\n});\n\n// Фильтр 2: убираем дубли по title\nconst deduped = recent.filter(item => {\n  const title = (item.json.title || '').toLowerCase().trim();\n  return !existingTitles.has(title);\n});\n\n// Фильтр 3: берём максимум 3 статьи\nconst selected = deduped.slice(0, 3);\n\nif (selected.length === 0) {\n  return [];\n}\n\nreturn selected.map(item => ({\n  json: {\n    source_title: item.json.title || '',\n    source_url: item.json.link || '',\n    source_content: (item.json.content || item.json.contentSnippet || item.json.description || '').substring(0, 2000),\n    source_date: item.json.pubDate || item.json.isoDate || ''\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
