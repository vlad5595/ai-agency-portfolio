      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst content = response.choices[0].message.content;\nconst data = JSON.parse(content);\n\nconst now = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst dateStr = `${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}`;\nconst seq = pad(Math.floor(Math.random() * 999) + 1, 3).toString().padStart(3, '0');\nconst docId = `DF-${dateStr}-${seq}`;\n\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nreturn [{\n  json: {\n    doc_id: docId,\n    contractor: data.contractor || '',\n    inn: data.inn || '',\n    invoice_number: data.invoice_number || '',\n    date: data.date || '',\n    amount: data.amount || 0,\n    vat: data.vat || 0,\n    purpose: data.purpose || '',\n    created_at: now.toISOString(),\n    chat_id: chatId,\n    summary: `📄 Счёт на оплату\\n\\n` +\n      `Поставщик: ${data.contractor}\\n` +\n      `ИНН: ${data.inn}\\n` +\n      `Счёт №${data.invoice_number} от ${data.date}\\n` +\n      `Сумма: ${data.amount} руб. (НДС: ${data.vat} руб.)\\n` +\n      `Назначение: ${data.purpose}\\n\\n` +\n      `✅ Записано в таблицу | ID: ${docId}`\n  }\n}];"
