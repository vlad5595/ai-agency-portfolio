      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst content = response.choices[0].message.content;\nconst data = JSON.parse(content);\n\nconst now = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst dateStr = `${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}`;\nconst seq = String(Math.floor(Math.random() * 999) + 1).padStart(3, '0');\nconst docId = `DF-${dateStr}-${seq}`;\n\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nconst metricsList = (data.key_metrics || [])\n  .map(m => `  • ${m.name}: ${m.value}${m.change ? ' (' + m.change + ')' : ''}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    doc_id: docId,\n    report_type: data.report_type || '',\n    period: data.period || '',\n    key_metrics_json: JSON.stringify(data.key_metrics || []),\n    summary: data.summary || '',\n    anomalies: data.anomalies || '',\n    created_at: now.toISOString(),\n    chat_id: chatId,\n    telegram_summary: `📊 Отчёт: ${data.report_type}\\n` +\n      `Период: ${data.period}\\n\\n` +\n      `Ключевые метрики:\\n${metricsList}\\n\\n` +\n      `Сводка: ${data.summary}\\n` +\n      (data.anomalies ? `\\n⚠️ ${data.anomalies}\\n` : '') +\n      `\\n✅ Записано в таблицу | ID: ${docId}`\n  }\n}];"
      },
