    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst content = response.choices[0].message.content;\nconst data = JSON.parse(content);\n\nconst now = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst dateStr = `${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}`;\nconst seq = String(Math.floor(Math.random() * 999) + 1).padStart(3, '0');\nconst docId = `DF-${dateStr}-${seq}`;\n\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nconst itemsList = (data.items || [])\n  .map((it, i) => `  ${i+1}. ${it.name} — ${it.quantity} ${it.unit} × ${it.price} = ${it.sum}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    doc_id: docId,\n    supplier: data.supplier || '',\n    recipient: data.recipient || '',\n    date: data.date || '',\n    items_json: JSON.stringify(data.items || []),\n    items_count: (data.items || []).length,\n    total_amount: data.total_amount || 0,\n    created_at: now.toISOString(),\n    chat_id: chatId,\n    summary: `📦 Товарная накладная\\n\\n` +\n      `Поставщик: ${data.supplier}\\n` +\n      `Получатель: ${data.recipient}\\n` +\n      `Дата: ${data.date}\\n` +\n      `Позиций: ${(data.items || []).length}\\n\\n` +\n      itemsList + `\\n\\n` +\n      `Итого: ${data.total_amount} руб.\\n\\n` +\n      `✅ Записано в таблицу | ID: ${docId}`\n  }\n}];"
      },
