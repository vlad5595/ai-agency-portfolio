    {
      "parameters": {
        "jsCode": "const text = $input.first().json.text || '';\n\n// Обрезаем текст до ~3000 символов — для классификации больше не нужно\nconst truncated = text.substring(0, 3000);\n\nconst requestBody = JSON.stringify({\n  model: \"deepseek-chat\",\n  messages: [\n    {\n      role: \"system\",\n      content: `Ты — классификатор документов. Тебе дают текст, извлечённый из PDF.\nОпредели тип документа. Возможные типы:\n- \"invoice\" — счёт на оплату, счёт-фактура\n- \"waybill\" — товарная накладная, транспортная накладная, акт приёма-передачи\n- \"report\" — отчёт (о продажах, маркетинговый, финансовый, аналитический)\n\nВерни ТОЛЬКО JSON: {\"doc_type\": \"invoice\"|\"waybill\"|\"report\", \"confidence\": \"high\"|\"medium\"|\"low\"}\nНикакого текста кроме JSON.`\n    },\n    {\n      role: \"user\",\n      content: truncated\n    }\n  ],\n  response_format: { type: \"json_object\" },\n  temperature: 0\n});\n\nreturn [{ json: { request_body: requestBody, original_text: text } }];"
      },
