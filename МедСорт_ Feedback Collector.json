    {
      "parameters": {
        "jsCode": "const rows = $('Get Confirmed Inquiries').all();\nconst now = new Date();\n\nconst ready = rows.filter(r => {\n  if (!r.json.inquiry_id) return false;\n  if (r.json.status !== 'confirmed') return false;\n  if (r.json.feedback_sent === 'TRUE') return false;\n  \n  // Проверяем что прошло больше 24 часов\n  const created = new Date(r.json.created_at);\n  const hours = (now - created) / (1000 * 60 * 60);\n  return hours >= 24;\n});\n\nif (ready.length === 0) {\n  return { has_items: false };\n}\n\nreturn ready.map(r => ({\n  has_items: true,\n  inquiry_id: r.json.inquiry_id,\n  client_name: r.json.client_name,\n  client_telegram_id: r.json.client_telegram_id,\n  direction: r.json.direction,\n  language: r.json.language || 'ru'\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "eec12f55-6d7a-4659-a67d-15c983c1252b",
      "name": "Filter Ready for Feedback"
    },
