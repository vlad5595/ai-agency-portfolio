    {
      "parameters": {
        "jsCode": "const d = $json;\n\nconst text = d.language === 'en'\n  ? `Hello, ${d.client_name}! You recently visited our clinic (${d.direction}). How was your experience? Please rate from 1 to 5, where 1 is poor and 5 is excellent.`\n  : `Здравствуйте, ${d.client_name}! Вы недавно обращались в нашу клинику (${d.direction}). Как прошёл приём? Оцените от 1 до 5, где 1 — плохо, 5 — отлично.`;\n\nconst sendBody = JSON.stringify({\n  chat_id: d.client_telegram_id,\n  text: text\n});\n\nreturn {\n  send_body: sendBody,\n  inquiry_id: d.inquiry_id\n};"
      },
